# Server Configuration
PORT=8081
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=notification_db
MONGODB_COLLECTION=notifications

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=todo-events
KAFKA_GROUP_ID=notification-service
KAFKA_CLIENT_ID=notification-consumer

# Email Configuration (MailHog for development)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@todoapp.com

# Push Notification Configuration (Optional)
PUSH_NOTIFICATION_ENABLED=false
FCM_SERVER_KEY=